# Control plane
AIMUSIC_CONTROL_PLANE_BASE_URL=http://127.0.0.1:8092

# Worker identity
AIMUSIC_WORKER_PROVIDER=autodl
AIMUSIC_WORKER_VERSION=autodl-worker-dev
AIMUSIC_WORKER_SUPPORTED_JOB_TYPES=PROCESS,TRAIN,INFER

# Local storage
AIMUSIC_WORKER_STATE_DIR=./.state
AIMUSIC_WORKER_RUNS_DIR=./runs

# Polling and timeouts
AIMUSIC_WORKER_REQUEST_TIMEOUT_SECONDS=30
AIMUSIC_WORKER_IDLE_SLEEP_SECONDS=5
AIMUSIC_WORKER_PROGRESS_INTERVAL_SECONDS=10
AIMUSIC_WORKER_PREFETCH_RESOURCES=true

# Mock mode
AIMUSIC_WORKER_USE_MOCK_EXECUTOR=false
AIMUSIC_WORKER_MOCK_DELAY_SECONDS=2

# AutoDL + RVC WebUI runtime
AIMUSIC_RVC_ROOT_DIR=/Retrieval-based-Voice-Conversion-WebUI
AIMUSIC_RVC_PYTHON_BIN=/root/miniconda3/bin/python
AIMUSIC_RVC_DEVICE=cuda:0
AIMUSIC_RVC_GPU_IDS=0
# This is the model architecture version expected by the repo code.
# Current upstream RVC WebUI uses v1 / v2 here, even if your image is branded as "RVC v4".
AIMUSIC_RVC_VERSION=v2
AIMUSIC_RVC_USE_F0=true
AIMUSIC_RVC_INDEX_ENABLED=true
AIMUSIC_RVC_INDEX_REQUIRED=false
AIMUSIC_RVC_PREPROCESS_WORKERS=2
AIMUSIC_RVC_F0_WORKERS=1
AIMUSIC_RVC_RMVPE_GPU_IDS=
AIMUSIC_RVC_SAVE_EVERY_EPOCH=10
AIMUSIC_RVC_SAVE_LATEST=true
AIMUSIC_RVC_CACHE_GPU=false
AIMUSIC_RVC_SAVE_EVERY_WEIGHTS=false
AIMUSIC_RVC_IS_HALF=true
AIMUSIC_RVC_PREPROCESS_PER=3.7
AIMUSIC_RVC_NOPARALLEL=0
AIMUSIC_RVC_SPEAKER_ID=0
AIMUSIC_RVC_INDEX_RATE=0.66
AIMUSIC_RVC_FILTER_RADIUS=3
AIMUSIC_RVC_RESAMPLE_SR=0
AIMUSIC_RVC_RMS_MIX_RATE=1.0
AIMUSIC_RVC_PROTECT=0.33
AIMUSIC_RVC_F0_UP_KEY=0

# Optional real pipeline commands
# Available placeholders:
# {job_id} {job_type} {worker_dir} {run_dir} {context_path} {payload_path} {resources_path}
# {input_asset_ids} {dataset_version} {model_version} {workflow}
AIMUSIC_PROCESS_COMMAND='python3 pipelines/process_job.py --context "{context_path}" --run-dir "{run_dir}"'
AIMUSIC_TRAIN_COMMAND='python3 pipelines/train_job.py --context "{context_path}" --run-dir "{run_dir}"'
AIMUSIC_INFER_COMMAND='python3 pipelines/infer_job.py --context "{context_path}" --run-dir "{run_dir}"'

# PROCESS pipeline tuning
AIMUSIC_PROCESS_OUTPUT_SAMPLE_RATE=40000
AIMUSIC_PROCESS_TARGET_CHANNELS=1
AIMUSIC_PROCESS_MIN_SEGMENT_SECONDS=2
AIMUSIC_PROCESS_MAX_SEGMENT_SECONDS=12
AIMUSIC_PROCESS_SILENCE_DB=-35dB
AIMUSIC_PROCESS_SILENCE_DURATION_SECONDS=0.35
AIMUSIC_PROCESS_AUDIO_FILTERS=highpass=f=80,lowpass=f=12000,loudnorm=I=-16:TP=-1.5:LRA=11
AIMUSIC_PROCESS_VOCAL_TOOL=demucs
AIMUSIC_PROCESS_ENABLE_DEMUCS=true
AIMUSIC_PROCESS_DEMUCS_MODEL=htdemucs
AIMUSIC_PROCESS_UVR_COMMAND=
AIMUSIC_PROCESS_KEEP_INTERMEDIATE=false
AIMUSIC_PROCESS_FFMPEG_BIN=ffmpeg
AIMUSIC_PROCESS_FFPROBE_BIN=ffprobe

# TRAIN pipeline tuning
AIMUSIC_TRAIN_WORKSPACE_DIR_NAME=train-workspace
AIMUSIC_TRAIN_DATASET_DIR_NAME=dataset
AIMUSIC_TRAIN_OUTPUT_DIR_NAME=train-output
AIMUSIC_TRAIN_DATASET_STAGE_MODE=symlink
AIMUSIC_TRAIN_MODEL_GLOB=*.pth
AIMUSIC_TRAIN_INDEX_GLOB=*.index
AIMUSIC_TRAIN_PREVIEW_GLOB=*.wav
AIMUSIC_TRAIN_BUNDLE_NAME=model-artifacts.zip
AIMUSIC_TRAIN_KEEP_WORKSPACE=false
AIMUSIC_RVC_TRAIN_MODE=webui_auto

# Leave empty to use built-in WebUI auto mode.
# It now auto-detects both:
# 1. root-level script layout like trainset_preprocess_pipeline_print.py
# 2. official nested infer/modules/... layout
AIMUSIC_RVC_TRAIN_COMMAND=

# INFER pipeline tuning
AIMUSIC_INFER_WORKSPACE_DIR_NAME=infer-workspace
AIMUSIC_INFER_MODEL_DIR_NAME=model
AIMUSIC_INFER_INPUTS_DIR_NAME=inputs
AIMUSIC_INFER_OUTPUT_DIR_NAME=infer-output
AIMUSIC_INFER_INPUT_STAGE_MODE=symlink
AIMUSIC_INFER_OUTPUT_GLOB=*.wav
AIMUSIC_INFER_BUNDLE_EXTRACT_DIR_NAME=bundle
AIMUSIC_INFER_KEEP_WORKSPACE=false
AIMUSIC_RVC_INFER_MODE=webui_auto

# Leave empty to use built-in WebUI auto mode.
# It auto-detects nested infer_cli or the newer root-level infer-web style pipeline.
AIMUSIC_RVC_INFER_COMMAND=
