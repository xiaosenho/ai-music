# Control plane
AIMUSIC_CONTROL_PLANE_BASE_URL=http://127.0.0.1:8092

# Worker identity
AIMUSIC_WORKER_PROVIDER=autodl
AIMUSIC_WORKER_VERSION=autodl-worker-dev
AIMUSIC_WORKER_SUPPORTED_JOB_TYPES=PROCESS,TRAIN,INFER

# Local storage
AIMUSIC_WORKER_STATE_DIR=./.state
AIMUSIC_WORKER_RUNS_DIR=./runs

# Polling and timeouts
AIMUSIC_WORKER_REQUEST_TIMEOUT_SECONDS=30
AIMUSIC_WORKER_IDLE_SLEEP_SECONDS=5
AIMUSIC_WORKER_PROGRESS_INTERVAL_SECONDS=10
AIMUSIC_WORKER_PREFETCH_RESOURCES=true

# Mock mode
AIMUSIC_WORKER_USE_MOCK_EXECUTOR=true
AIMUSIC_WORKER_MOCK_DELAY_SECONDS=2

# Optional real pipeline commands
# Available placeholders:
# {job_id} {job_type} {run_dir} {context_path} {payload_path}
# {input_asset_ids} {dataset_version} {model_version} {workflow}
AIMUSIC_PROCESS_COMMAND=
AIMUSIC_TRAIN_COMMAND=
AIMUSIC_INFER_COMMAND=
